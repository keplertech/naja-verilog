# Core naja-verilog library and executable targets.

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@bison//:bison.bzl", "bison")
load("@flex//:flex.bzl", "flex")

bison(
    name = "VerilogParser",
    srcs = ["src/VerilogParser.yy"],
    outs = ["src/VerilogParser.cpp", "src/VerilogParser.hpp", "src/location.hh"],
    args = [
        "--output=$(execpath src/VerilogParser.cpp)",
        "--defines=$(execpath src/VerilogParser.hpp)",
        "$(execpath src/VerilogParser.yy)",
    ],
)

flex(
    name = "VerilogScanner_gen",
    srcs = ["src/VerilogScanner.ll"],
    outs = ["src/VerilogScanner_gen.cpp"],
    args = ["--c++", "--outfile=$(execpath src/VerilogScanner_gen.cpp)", "$(execpath src/VerilogScanner.ll)"],
)

cc_library(
    name = "naja_verilog",
    srcs = [
        "src/VerilogParser.cpp",
        ":VerilogScanner_gen",
        "src/VerilogTypes.cpp",
        "src/VerilogPreprocessor.cpp",
        "src/VerilogConstructor.cpp",
    ],
    hdrs = [
        "src/VerilogParser.hpp",
        "src/location.hh",
        "src/VerilogTypes.h",
        "src/VerilogPreprocessor.h",
        "src/VerilogConstructor.h",
        "src/VerilogException.h",
        "src/VerilogScanner.h",
    ],
    includes = ["src"],
    deps = ["@flex//:headers"],
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "naja_verilog_test",
    srcs = ["src/NajaVerilogSnippet.cpp"],
    deps = [":naja_verilog"],
)

cc_test(
    name = "naja_verilog_tests",
    srcs = glob(["test/*.cpp"]) + ["test/VerilogConstructorTest.h"],
    data = glob(["test/benchmarks/**"]),
    defines = ["NAJA_VERILOG_BENCHMARKS=\\\"test/benchmarks\\\""],
    includes = ["test"],
    deps = [
        ":naja_verilog",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)
